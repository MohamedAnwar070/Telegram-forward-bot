# ==============================================================
# Telegram Forward Bot - Environment Configuration Template
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================

# ==================== TELEGRAM API CREDENTIALS ====================
# Obtain from https://my.telegram.org (under API Development Tools)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Obtain from @BotFather on Telegram (/newbot)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# ==================== ADMIN CONFIGURATION ====================
# Your Telegram User ID (obtain from @userinfobot)
ADMIN_ID=987654321

# ==================== DATABASE CONFIGURATION ====================
# MongoDB connection URI (Local or MongoDB Atlas cloud instance)
MONGO_URI=mongodb://localhost:27017/forward_engine
# Cloud Atlas Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/forward_engine?retryWrites=true&w=majority

# ==================== ENCRYPTION & SECURITY ====================
# 32-url-safe base64-encoded Fernet key for encrypting user account sessions
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=xQ8W3vR9pK2mN5bH7jL0sF4dG6aT1eY8cZ3xV5nM2qW=

# ==================== OPTIONAL NOTIFICATIONS ====================
# Discord or Slack webhook for system health, error alerts, and queue status
# WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz
